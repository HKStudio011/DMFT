@page "/settings"
@using CommunityToolkit.Maui.Storage
@inject IAppUpdateService UpdateSvc
@inject IDbContextFactory<AppDbContext> DbFactory
@rendermode InteractiveRenderSettings.InteractiveServer

<PageTitle>DMFT - Settings</PageTitle>

<h1 class="text-2xl font-bold text-surface mb-6">Settings</h1>

<div class="space-y-6 max-w-2xl">

    @* Theme *@
    <div class="bg-background rounded-lg p-5 border">
        <h2 class="text-lg font-semibold text-surface mb-4">Theme</h2>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-surface mb-1">Mode</label>
                <select class="w-full px-3 py-2 border rounded bg-background text-surface focus:ring-2 focus:ring-primary"
                        @bind="ThemeMode">
                    <option  value="light">Light</option>
                    <option  value="dark">Dark</option>
                    <option  value="system">System</option>
                </select>
            </div>
        </div>
    </div>

    @* yt-dlp Configuration *@
    <div class="bg-background rounded-lg p-5 border ">
        <h2 class="text-lg font-semibold text-surface mb-4">yt-dlp Configuration</h2>
        <div class="space-y-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-surface mb-1">Max Concurrent Downloads</label>
                    <input type="number" class="w-full px-3 py-2 border  rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary"
                           @bind="MaxConcurrent" min="1" max="10" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-surface mb-1">Delay Between Downloads (s)</label>
                    <input type="number" class="w-full px-3 py-2 border  rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary"
                           @bind="DelayBetweenSeconds" min="0" max="30" step="1" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-surface mb-1">Default Download Path</label>
                <div class="relative">
                    <input type="text" class="w-full pr-18 px-3 py-2 border  rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary"
                           @bind="DefaultPath" />
                    <button @onclick="PickFolder" type="button"
                            class="absolute right-1 top-1/2 -translate-y-1/2 btn btn-primary !py-1 !px-2 text-xs">
                        Browse
                    </button>
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-surface mb-1">Extra yt-dlp Arguments</label>
                <input type="text" 
                       class="w-full px-3 py-2 border  rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary font-mono text-sm"
                       placeholder="--no-mtime --embed-thumbnail"
                       @bind="ExtraArgs" />
                <div class="text-xs text-secondary mt-1">
                    Common: --restrict-filenames, --no-warnings, --embed-thumbnail, --retries 10
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-surface mb-1">Output Filename Template</label>
                <input type="text" 
                       class="w-full px-3 py-2 border  rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary font-mono text-sm"
                       placeholder="%(title)s [%(id)s].%(ext)s"
                       @bind="OutputTemplate" />
                <div class="text-xs text-secondary mt-1">
                    Leave empty to use default. Variables: %(title)s, %(id)s, %(uploader)s, %(ext)s
                </div>
            </div>
        </div>
    </div>

    @* Download Quality *@
    <div class="bg-background rounded-lg p-5 border ">
        <h2 class="text-lg font-semibold text-surface mb-4">Download Quality</h2>
        <div class="space-y-3">
            <div>
                <label class="block text-sm font-medium text-surface mb-1">Quality Preset</label>
                <select class="w-full px-3 py-2 border  rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary"
                        @bind="QualityPreset">
                    @foreach (var kvp in _qualityPresets)
                    {
                        <option value="@kvp.Key">@kvp.Value.label</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @* Updates *@
    <div class="bg-background rounded-lg p-5 border ">
        <h2 class="text-lg font-semibold text-surface mb-4">Updates</h2>
        @if (_updateCheckResult != null)
        {
            <div class="mb-3">
                @if (_updateAvailable)
                {
                    <div class="text-primary font-medium mb-2">Update available: @_updateCheckResult.TagName</div>
                }
                else
                {
                    <div class="text-secondary mb-2">You are on the latest version.</div>
                }
            </div>
        }
        <div class="flex gap-2">
            <button class="btn btn-primary"
                    @onclick="CheckForUpdates" disabled="@_checking">
                @(_checking ? "Checking..." : "Check for Updates")
            </button>
        </div>
    </div>

    @* Save *@
    <div class="flex gap-3">
        <button class="btn btn-primary"
                @onclick="SaveSettings">Save Settings</button>
        <button class="btn btn-danger"
                @onclick="ResetSettings">Reset</button>
    </div>

</div>

@code {
    private string ThemeMode = "system";
    private int MaxConcurrent = 3;
    private int _delayBetweenMs = 1000;
    private int DelayBetweenSeconds { get => _delayBetweenMs / 1000; set => _delayBetweenMs = value * 1000; }
    private string DefaultPath = "";
    private string QualityPreset = "best";
    private static readonly Dictionary<string, (string label, string format)> _qualityPresets = new()
    {
        { "best", ("Best quality", "bestvideo[ext=mp4]+bestaudio/bestvideo[ext=mp4]+bestaudio/best") },
        { "1080p", ("1080p (Full HD)", "bestvideo[height<=1080][ext=mp4]+bestaudio/bestvideo[height<=1080]+bestaudio/best") },
        { "720p", ("720p (HD)", "bestvideo[height<=720][ext=mp4]+bestaudio/bestvideo[height<=720]+bestaudio/best") },
        { "480p", ("480p (SD)", "bestvideo[height<=480][ext=mp4]+bestaudio/bestvideo[height<=480]+bestaudio/best") },
        { "audio", ("Audio only", "bestaudio") }
    };
    private string ExtraArgs = "";
    private string OutputTemplate = "";
    private ReleaseInfo? _updateCheckResult;
    private bool _updateAvailable;
    private bool _checking;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ApplyTheme();
    }

    private async Task LoadSettings()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var theme = await db.AppSettings.FindAsync("theme");
        if (theme != null) ThemeMode = theme.Value;

        var path = await db.AppSettings.FindAsync("defaultPath");
        if (path != null) DefaultPath = path.Value;

        var conc = await db.AppSettings.FindAsync("maxConcurrent");
        if (conc != null && int.TryParse(conc.Value, out var c)) MaxConcurrent = c;

        var delay = await db.AppSettings.FindAsync("delayBetweenMs");
        if (delay != null && int.TryParse(delay.Value, out var d)) _delayBetweenMs = d;

        var formatKey = await db.AppSettings.FindAsync("ytdlp_format");
        if (formatKey != null)
        {
            var match = _qualityPresets.FirstOrDefault(p => p.Value.format == formatKey.Value);
            QualityPreset = match.Key ?? "best";
        }

        var extra = await db.AppSettings.FindAsync("ytdlp_extra_args");
        if (extra != null) ExtraArgs = extra.Value;

        var template = await db.AppSettings.FindAsync("ytdlp_output_template");
        if (template != null) OutputTemplate = template.Value;
    }

    private async Task ApplyTheme()
    {
        await JS.InvokeVoidAsync("dmftTheme.applyTheme", ThemeMode);
    }

    private async Task PickFolder()
    {
        try
        {
            var result = await FolderPicker.Default.PickAsync(CancellationToken.None);
            if (result.IsSuccessful)
                DefaultPath = result.Folder.Path;
        }
        catch
        {
            Toast.Show("Folder picker is not available on this platform", ToastLevel.Error);
        }
    }

    private async Task CheckForUpdates()
    {
        _checking = true;
        try
        {
            var release = await UpdateSvc.CheckForUpdatesAsync("2.0.0");
            _updateCheckResult = release;
            _updateAvailable = release != null && UpdateSvc.IsUpdateAvailable(release, "2.0.0");
        }
        catch
        {
            Toast.Show("Failed to check for updates", ToastLevel.Error);
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task SaveSettings()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Validate ExtraArgs
        if (!string.IsNullOrWhiteSpace(ExtraArgs))
        {
            string[] dangerous = { ";", "|", "`", "$", "&&", "||", "\n" };
            foreach (var c in dangerous)
            {
                if (ExtraArgs.Contains(c))
                {
                    Toast.Show($"Extra arguments contain invalid character: {c}", ToastLevel.Error);
                    return;
                }
            }
        }

        await SetAppSettingAsync(db, "theme", ThemeMode);
        await SetAppSettingAsync(db, "defaultPath", DefaultPath);
        await SetAppSettingAsync(db, "maxConcurrent", MaxConcurrent.ToString());
        await SetAppSettingAsync(db, "delayBetweenMs", _delayBetweenMs.ToString());

        var formatKvp = _qualityPresets[QualityPreset];
        await SetAppSettingAsync(db, "ytdlp_format", formatKvp.format);
        await SetAppSettingAsync(db, "ytdlp_extra_args", ExtraArgs);
        await SetAppSettingAsync(db, "ytdlp_output_template", OutputTemplate);

        var dl = await db.DownloadSettings.FindAsync("default");
        if (dl == null)
        {
            db.DownloadSettings.Add(new DownloadSetting { Id = "default", DefaultPath = DefaultPath });
        }
        else
        {
            dl.DefaultPath = DefaultPath;
        }

        await db.SaveChangesAsync();
        await ApplyTheme();
        Toast.Show("Settings saved", ToastLevel.Success);
    }

    private static async Task SetAppSettingAsync(AppDbContext db, string id, string value)
    {
        var existing = await db.AppSettings.FindAsync(id);
        if (existing == null)
        {
            db.AppSettings.Add(new AppSetting { Id = id, Value = value });
        }
        else
        {
            existing.Value = value;
        }
    }

    private async Task ResetSettings()
    {
        ThemeMode = "system";
        MaxConcurrent = 3;
        _delayBetweenMs = 1000;
        DefaultPath = "";
        QualityPreset = "best";
        ExtraArgs = "";
        OutputTemplate = "";
        await ApplyTheme();
        Toast.Show("Settings reset to defaults", ToastLevel.Info);
        StateHasChanged();
    }
}
