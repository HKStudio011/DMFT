@page "/settings"
@using DMFT.Core.Data
@using DMFT.Core.Entities
@using DMFT.Core.Services
@using DMFT.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAppUpdateService UpdateSvc
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>DMFT - Settings</PageTitle>

<h1 class="text-2xl font-bold text-on-surface mb-6">Settings</h1>

<div class="space-y-6 max-w-2xl">

    @* Theme *@
    <div class="bg-surface rounded-lg p-5 border border-outline-variant">
        <h2 class="text-lg font-semibold text-on-surface mb-4">Theme</h2>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-on-surface mb-1">Mode</label>
                <select class="w-full px-3 py-2 border border-outline rounded bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                        @bind="ThemeMode">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="system">System</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-on-surface mb-1">Accent Color</label>
                <select class="w-full px-3 py-2 border border-outline rounded bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                        @bind="AccentColor">
                    <option value="blue">Blue</option>
                    <option value="gold">Gold</option>
                    <option value="green">Green</option>
                    <option value="purple">Purple</option>
                    <option value="red">Red</option>
                </select>
            </div>
        </div>
    </div>

    @* yt-dlp Configuration *@
    <div class="bg-surface rounded-lg p-5 border border-outline-variant">
        <h2 class="text-lg font-semibold text-on-surface mb-4">yt-dlp Configuration</h2>
        <div class="space-y-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-on-surface mb-1">Max Concurrent Downloads</label>
                    <input type="number" class="w-full px-3 py-2 border border-outline rounded bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                           @bind="MaxConcurrent" min="1" max="10" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-on-surface mb-1">Delay Between Downloads (ms)</label>
                    <input type="number" class="w-full px-3 py-2 border border-outline rounded bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                           @bind="DelayBetweenMs" min="0" max="30000" step="100" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-on-surface mb-1">Default Download Path</label>
                <input type="text" class="w-full px-3 py-2 border border-outline rounded bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                       @bind="DefaultPath" />
            </div>
        </div>
    </div>

    @* Updates *@
    <div class="bg-surface rounded-lg p-5 border border-outline-variant">
        <h2 class="text-lg font-semibold text-on-surface mb-4">Updates</h2>
        @if (_updateCheckResult != null)
        {
            <div class="mb-3">
                @if (_updateAvailable)
                {
                    <div class="text-primary font-medium mb-2">Update available: @_updateCheckResult.TagName</div>
                }
                else
                {
                    <div class="text-on-surface-dim mb-2">You are on the latest version.</div>
                }
            </div>
        }
        <div class="flex gap-2">
            <button class="px-4 py-2 rounded bg-primary text-on-primary hover:brightness-110 border-0 cursor-pointer text-sm"
                    @onclick="CheckForUpdates" disabled="@_checking">
                @(_checking ? "Checking..." : "Check for Updates")
            </button>
        </div>
    </div>

    @* Save *@
    <div class="flex gap-3">
        <button class="px-6 py-2.5 rounded bg-primary text-on-primary hover:brightness-110 border-0 cursor-pointer font-medium"
                @onclick="SaveSettings">Save Settings</button>
        <button class="px-6 py-2.5 rounded bg-surface-variant text-on-surface hover:bg-surface-container-high border-0 cursor-pointer font-medium"
                @onclick="ResetSettings">Reset</button>
    </div>

</div>

@code {
    private string ThemeMode = "system";
    private string AccentColor = "blue";
    private int MaxConcurrent = 3;
    private int DelayBetweenMs = 500;
    private string DefaultPath = "";
    private ReleaseInfo? _updateCheckResult;
    private bool _updateAvailable;
    private bool _checking;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
        await ApplyTheme();
    }

    private async Task LoadSettings()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var theme = await db.AppSettings.FindAsync("theme");
        if (theme != null) ThemeMode = theme.Value;

        var color = await db.AppSettings.FindAsync("accentColor");
        if (color != null) AccentColor = color.Value;

        var path = await db.AppSettings.FindAsync("defaultPath");
        if (path != null) DefaultPath = path.Value;

        var conc = await db.AppSettings.FindAsync("maxConcurrent");
        if (conc != null && int.TryParse(conc.Value, out var c)) MaxConcurrent = c;

        var delay = await db.AppSettings.FindAsync("delayBetweenMs");
        if (delay != null && int.TryParse(delay.Value, out var d)) DelayBetweenMs = d;
    }

    private async Task ApplyTheme()
    {
        await JS.InvokeVoidAsync("dmftTheme.applyTheme", ThemeMode, AccentColor);
    }

    private async Task CheckForUpdates()
    {
        _checking = true;
        try
        {
            var release = await UpdateSvc.CheckForUpdatesAsync("2.0.0");
            _updateCheckResult = release;
            _updateAvailable = release != null && UpdateSvc.IsUpdateAvailable(release, "2.0.0");
        }
        catch
        {
            Toast.Show("Failed to check for updates", ToastLevel.Error);
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task SaveSettings()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        await SetAppSettingAsync(db, "theme", ThemeMode);
        await SetAppSettingAsync(db, "accentColor", AccentColor);
        await SetAppSettingAsync(db, "defaultPath", DefaultPath);
        await SetAppSettingAsync(db, "maxConcurrent", MaxConcurrent.ToString());
        await SetAppSettingAsync(db, "delayBetweenMs", DelayBetweenMs.ToString());

        var dl = await db.DownloadSettings.FindAsync("default");
        if (dl == null)
        {
            db.DownloadSettings.Add(new DownloadSetting { Id = "default", DefaultPath = DefaultPath });
        }
        else
        {
            dl.DefaultPath = DefaultPath;
        }

        await db.SaveChangesAsync();
        await ApplyTheme();
        Toast.Show("Settings saved", ToastLevel.Success);
    }

    private static async Task SetAppSettingAsync(AppDbContext db, string id, string value)
    {
        var existing = await db.AppSettings.FindAsync(id);
        if (existing == null)
        {
            db.AppSettings.Add(new AppSetting { Id = id, Value = value });
        }
        else
        {
            existing.Value = value;
        }
    }

    private async Task ResetSettings()
    {
        ThemeMode = "system";
        AccentColor = "blue";
        MaxConcurrent = 3;
        DelayBetweenMs = 500;
        DefaultPath = "";
        await ApplyTheme();
        Toast.Show("Settings reset to defaults", ToastLevel.Info);
    }
}
